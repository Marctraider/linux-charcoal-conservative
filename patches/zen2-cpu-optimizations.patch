From: Steam Deck Zen 2 target
Subject: [PATCH] x86: compile Steam Deck kernel for AMD Zen 2

Use the Steam Deck's Zen 2 CPU target directly instead of importing a
large collection of unrelated x86 compiler target options.

diff --git a/arch/x86/Makefile b/arch/x86/Makefile
--- a/arch/x86/Makefile
+++ b/arch/x86/Makefile
@@ -170,3 +170,3 @@
 else
-        KBUILD_CFLAGS += -march=x86-64 -mtune=generic
-        KBUILD_RUSTFLAGS += -Ctarget-cpu=x86-64 -Ztune-cpu=generic
+        KBUILD_CFLAGS += -march=znver2
+        KBUILD_RUSTFLAGS += -Ctarget-cpu=znver2
 endif
